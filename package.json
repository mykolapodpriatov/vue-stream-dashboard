{
  "name": "vue-stream-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "A realtime dashboard built on one rule: high-frequency data should not directly drive the Vue render loop.",
  "license": "MIT",
  "author": "Mykola Podpriatov <nsplotos@gmail.com>",
  "homepage": "https://github.com/mykolapodpriatov/vue-stream-dashboard",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mykolapodpriatov/vue-stream-dashboard.git"
  },
  "bugs": {
    "url": "https://github.com/mykolapodpriatov/vue-stream-dashboard/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --build --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,vue,css,json,md,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,vue,css,json,md,yml}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build",
    "test:e2e": "playwright test",
    "bench": "playwright test --config playwright.bench.config.ts",
    "media": "tsx scripts/capture-media.ts"
  },
  "dependencies": {
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-i18n": "^11.4.10",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tsconfig/node22": "^22.0.2",
    "@types/node": "^24.10.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "eslint-plugin-vuejs-accessibility": "^2.6.0",
    "happy-dom": "^20.13.2",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ]
  }
}
