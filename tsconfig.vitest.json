{
  "extends": "./tsconfig.app.json",
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue", "test/**/*.ts"],
  "exclude": [],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.vitest.tsbuildinfo"
    // No Node types on purpose: tests exercise browser code under a DOM shim,
    // and `setTimeout` returning a number in one project and an object in
    // another would force casts into the code under test.
  }
}
