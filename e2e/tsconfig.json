{
  // Playwright specs run in Node and drive a browser; they belong to neither
  // the app project (no `process`) nor the Vitest project (no Playwright
  // globals), so they get their own.
  "extends": "@tsconfig/node22/tsconfig.json",
  "include": [
    "./**/*.ts",
    "../bench/**/*.ts",
    "../playwright.config.ts",
    "../playwright.bench.config.ts"
  ],
  "compilerOptions": {
    "noEmit": true,
    "tsBuildInfoFile": "../node_modules/.tmp/tsconfig.e2e.tsbuildinfo",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    // `page.evaluate` callbacks run in the browser and are typed as such.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  }
}
